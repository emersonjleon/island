{
  "$defs": {
    "AcceptOffer": {
      "additionalProperties": false,
      "description": "Accept another player's offer: the trade happens at once.",
      "properties": {
        "a": {
          "const": "accept_offer",
          "default": "accept_offer",
          "title": "A",
          "type": "string"
        },
        "offer": {
          "minimum": 0,
          "title": "Offer",
          "type": "integer"
        }
      },
      "required": [
        "offer"
      ],
      "title": "AcceptOffer",
      "type": "object"
    },
    "AdvanceAge": {
      "additionalProperties": false,
      "description": "Start researching the next age (ages, WP26): pay its cost and wait its time.",
      "properties": {
        "a": {
          "const": "advance_age",
          "default": "advance_age",
          "title": "A",
          "type": "string"
        }
      },
      "title": "AdvanceAge",
      "type": "object"
    },
    "BankTrade": {
      "additionalProperties": false,
      "description": "Trade with the bank (or a harbor the player owns; the rule picks the best ratio).\n\nStage 1: exactly one ``give`` resource and one different ``get`` resource,\npositive amounts. Whether ``give`` amount == ratio * ``get`` amount is a rule check\n(``trade.*`` codes), not a schema check.",
      "properties": {
        "a": {
          "const": "bank_trade",
          "default": "bank_trade",
          "title": "A",
          "type": "string"
        },
        "get": {
          "additionalProperties": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Resource"
          },
          "title": "Get",
          "type": "object"
        },
        "give": {
          "additionalProperties": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Resource"
          },
          "title": "Give",
          "type": "object"
        }
      },
      "required": [
        "give",
        "get"
      ],
      "title": "BankTrade",
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "description": "Start building. Settlement/city need ``vertex``; road needs ``edge``.\n``settler`` names the builder when one is required (setup / Settlers variation).",
      "properties": {
        "a": {
          "const": "build",
          "default": "build",
          "title": "A",
          "type": "string"
        },
        "edge": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge"
        },
        "kind": {
          "$ref": "#/$defs/BuildKind"
        },
        "settler": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settler"
        },
        "vertex": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertex"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Build",
      "type": "object"
    },
    "BuildKind": {
      "enum": [
        "road",
        "settlement",
        "city",
        "megacity"
      ],
      "title": "BuildKind",
      "type": "string"
    },
    "BuyDevCard": {
      "additionalProperties": false,
      "description": "Buy the top card of a development deck (stage 2). ``tier`` 2 or 3: an advanced\ndevelopment (ages with ``ages.dev_tiers``, from that age on).",
      "properties": {
        "a": {
          "const": "buy_dev_card",
          "default": "buy_dev_card",
          "title": "A",
          "type": "string"
        },
        "tier": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Tier",
          "type": "integer"
        }
      },
      "title": "BuyDevCard",
      "type": "object"
    },
    "BuySettler": {
      "additionalProperties": false,
      "description": "Buy a settler (Settlers variation, stage 3). It appears at ``vertex``, one of the\nplayer's buildings, or at their first building when left out.",
      "properties": {
        "a": {
          "const": "buy_settler",
          "default": "buy_settler",
          "title": "A",
          "type": "string"
        },
        "vertex": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertex"
        }
      },
      "title": "BuySettler",
      "type": "object"
    },
    "CancelAge": {
      "additionalProperties": false,
      "description": "Stop the age research in progress (refunded like a construction).",
      "properties": {
        "a": {
          "const": "cancel_age",
          "default": "cancel_age",
          "title": "A",
          "type": "string"
        }
      },
      "title": "CancelAge",
      "type": "object"
    },
    "CancelBuild": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "const": "cancel_build",
          "default": "cancel_build",
          "title": "A",
          "type": "string"
        },
        "construction": {
          "minimum": 0,
          "title": "Construction",
          "type": "integer"
        }
      },
      "required": [
        "construction"
      ],
      "title": "CancelBuild",
      "type": "object"
    },
    "CancelOffer": {
      "additionalProperties": false,
      "description": "Take one's own offer off the trade board.",
      "properties": {
        "a": {
          "const": "cancel_offer",
          "default": "cancel_offer",
          "title": "A",
          "type": "string"
        },
        "offer": {
          "minimum": 0,
          "title": "Offer",
          "type": "integer"
        }
      },
      "required": [
        "offer"
      ],
      "title": "CancelOffer",
      "type": "object"
    },
    "DevCardKind": {
      "enum": [
        "knight",
        "victory_point",
        "road_building",
        "year_of_plenty",
        "monopoly",
        "veteran_knight",
        "fishing_fleet",
        "merchant",
        "causeway",
        "bountiful_harvest",
        "elite_knight",
        "architect",
        "great_market",
        "tribute"
      ],
      "title": "DevCardKind",
      "type": "string"
    },
    "MoveSettler": {
      "additionalProperties": false,
      "description": "Walk ``settler`` to ``to_vertex``. ``replace`` re-paths (after the current\nedge); ``append`` queues the path after the already-queued one.",
      "properties": {
        "a": {
          "const": "move_settler",
          "default": "move_settler",
          "title": "A",
          "type": "string"
        },
        "mode": {
          "default": "replace",
          "enum": [
            "replace",
            "append"
          ],
          "title": "Mode",
          "type": "string"
        },
        "settler": {
          "minimum": 0,
          "title": "Settler",
          "type": "integer"
        },
        "to_vertex": {
          "minimum": 0,
          "title": "To Vertex",
          "type": "integer"
        }
      },
      "required": [
        "settler",
        "to_vertex"
      ],
      "title": "MoveSettler",
      "type": "object"
    },
    "PlayDevCard": {
      "additionalProperties": false,
      "description": "Play a development card (stage 2). Fields by card:\n\n* ``knight`` / ``veteran_knight`` / ``elite_knight``: ``hex`` (where the robber\n  goes) and, when several players could be robbed there, ``victim``;\n* ``year_of_plenty`` / ``bountiful_harvest``: ``resources`` (one entry per card\n  taken, repeats allowed);\n* ``architect``: ``resources``, the cards taken off the next city or megacity;\n* ``monopoly``: ``resource``;\n* any other card: nothing else.\n\nWhether the right fields are given for the card is a rule check (``dev.*`` codes).",
      "properties": {
        "a": {
          "const": "play_dev_card",
          "default": "play_dev_card",
          "title": "A",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/DevCardKind"
        },
        "hex": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hex"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Resource"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resources"
        },
        "victim": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Victim"
        }
      },
      "required": [
        "card"
      ],
      "title": "PlayDevCard",
      "type": "object"
    },
    "PostOffer": {
      "additionalProperties": false,
      "description": "Put an offer on the trade board (stage 2): the poster gives ``give`` and gets\n``get`` from whoever accepts. Both name at least one resource, never the same one.",
      "properties": {
        "a": {
          "const": "post_offer",
          "default": "post_offer",
          "title": "A",
          "type": "string"
        },
        "get": {
          "additionalProperties": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Resource"
          },
          "title": "Get",
          "type": "object"
        },
        "give": {
          "additionalProperties": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Resource"
          },
          "title": "Give",
          "type": "object"
        }
      },
      "required": [
        "give",
        "get"
      ],
      "title": "PostOffer",
      "type": "object"
    },
    "Resign": {
      "additionalProperties": false,
      "description": "Give up: the player leaves the game for good (see :mod:`engine.rules.resign`).",
      "properties": {
        "a": {
          "const": "resign",
          "default": "resign",
          "title": "A",
          "type": "string"
        }
      },
      "title": "Resign",
      "type": "object"
    },
    "Resource": {
      "enum": [
        "lumber",
        "brick",
        "wool",
        "grain",
        "ore",
        "fish"
      ],
      "title": "Resource",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "accept_offer": "#/$defs/AcceptOffer",
      "advance_age": "#/$defs/AdvanceAge",
      "bank_trade": "#/$defs/BankTrade",
      "build": "#/$defs/Build",
      "buy_dev_card": "#/$defs/BuyDevCard",
      "buy_settler": "#/$defs/BuySettler",
      "cancel_age": "#/$defs/CancelAge",
      "cancel_build": "#/$defs/CancelBuild",
      "cancel_offer": "#/$defs/CancelOffer",
      "move_settler": "#/$defs/MoveSettler",
      "play_dev_card": "#/$defs/PlayDevCard",
      "post_offer": "#/$defs/PostOffer",
      "resign": "#/$defs/Resign"
    },
    "propertyName": "a"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MoveSettler"
    },
    {
      "$ref": "#/$defs/Build"
    },
    {
      "$ref": "#/$defs/CancelBuild"
    },
    {
      "$ref": "#/$defs/BankTrade"
    },
    {
      "$ref": "#/$defs/BuyDevCard"
    },
    {
      "$ref": "#/$defs/PlayDevCard"
    },
    {
      "$ref": "#/$defs/PostOffer"
    },
    {
      "$ref": "#/$defs/CancelOffer"
    },
    {
      "$ref": "#/$defs/AcceptOffer"
    },
    {
      "$ref": "#/$defs/BuySettler"
    },
    {
      "$ref": "#/$defs/AdvanceAge"
    },
    {
      "$ref": "#/$defs/CancelAge"
    },
    {
      "$ref": "#/$defs/Resign"
    }
  ]
}
