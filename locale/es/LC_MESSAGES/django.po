#: lobby/messages.py:5
msgid "These settings are not valid together."
msgstr "Esta combinación de opciones no es válida."

#: lobby/messages.py:6
msgid "An island cannot be generated with these settings."
msgstr "No se puede generar una isla con estas opciones."

#: lobby/messages.py:7
