msgstr "Tu contraseña fue cambiada."

#: templates/accounts/password_reset.html:2
#: templates/accounts/password_reset.html:4
msgid "Reset password"
msgstr "Restablecer contraseña"

#: templates/accounts/password_reset.html:5
msgid ""
"Enter your email address and we will send you a link to choose a new "
"password."
msgstr ""
"Escribe tu correo y te enviaremos un enlace para elegir una contraseña "
"nueva."

#: templates/accounts/password_reset.html:9
msgid "Send reset link"
msgstr "Enviar enlace"

#: templates/accounts/password_reset_complete.html:2
#: templates/accounts/password_reset_complete.html:4
msgid "Password set"
msgstr "Contraseña establecida"

#: templates/accounts/password_reset_complete.html:5
msgid "Your new password is set."
msgstr "Tu contraseña nueva quedó establecida."

#: templates/accounts/password_reset_confirm.html:2
#: templates/accounts/password_reset_confirm.html:4
msgid "Choose a new password"
msgstr "Elige una contraseña nueva"

#: templates/accounts/password_reset_confirm.html:10
msgid "Set password"
msgstr "Guardar contraseña"

#: templates/accounts/password_reset_confirm.html:13
msgid ""
"This reset link is invalid or has already been used. Please ask for a new "
"one."
msgstr "Este enlace no es válido o ya se usó. Pide uno nuevo."

#: templates/accounts/password_reset_done.html:2
#: templates/accounts/password_reset_done.html:4
msgid "Check your email"
msgstr "Revisa tu correo"

#: templates/accounts/password_reset_done.html:5
msgid "If an account uses that address, we sent a link to reset its password."
msgstr ""
"Si alguna cuenta usa esa dirección, le enviamos un enlace para restablecer "
"la contraseña."

#: templates/accounts/password_reset_email.txt:1
#, python-format
msgid "Someone asked to reset the password for %(user)s on %(site_name)s."
msgstr "Alguien pidió restablecer la contraseña de %(user)s en %(site_name)s."

#: templates/accounts/password_reset_email.txt:3
msgid "Open this link to choose a new password:"
msgstr "Abre este enlace para elegir una contraseña nueva:"

#: templates/accounts/password_reset_email.txt:6
msgid "If you did not ask for this, you can ignore this email."
msgstr "Si no lo pediste, puedes ignorar este correo."

#: templates/accounts/password_reset_subject.txt:1
msgid "Reset your Ages of the Island password"
msgstr "Restablece tu contraseña de Ages of the Island"

